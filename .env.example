# ==========================================
# ContestMate 통합 환경변수 예시 (.env.example)
# ==========================================

# ------------------------------------------
# 1. Supabase (Database & Auth)
# ------------------------------------------
# Supabase 대시보드 > Project Settings > API 에서 확인 가능
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# PostgreSQL 연결 URL (Direct connection / PgBouncer)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# ------------------------------------------
# 2. Backend (FastAPI) 설정
# ------------------------------------------
ENVIRONMENT=development
API_V1_PREFIX=/api
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
SECRET_KEY=generate_a_secure_random_key_here

# ------------------------------------------
# 3. Notification (Telegram Bot API)
# ------------------------------------------
# Telegram @BotFather를 통해 생성한 토큰
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# ------------------------------------------
# 4. Scraper / Collector 설정
# ------------------------------------------
SCRAPER_HEADLESS=true
SCRAPER_REQUEST_TIMEOUT=15
SCRAPER_INTERVAL_HOURS=6

# ------------------------------------------
# 5. Frontend (Vite) 환경변수
# frontend/.env 에는 VITE_ 접두사 필요
# ------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_API_BASE_URL=http://localhost:8000/api
